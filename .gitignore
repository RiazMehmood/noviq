echo.db-*
echo.db.bak-*

# ─── Eval run outputs (regenerable) ──────────────────────────────────────────
logs/
!logs/eval/COMPARISON.md

# ─── Manual file backups ─────────────────────────────────────────────────────
*.bak-*

# ─── Phase 9a ingestion sidecar (PyInstaller frozen binary) ──────────────────
# 29 MB rebuildable artifact — keep source + build.sh tracked, not the binary.
# Produce locally / in CI: cd src-tauri/sidecars/ingestion-sidecar && ./build.sh
src-tauri/binaries/ingestion-sidecar-*
src-tauri/sidecars/ingestion-sidecar/.build-venv/
src-tauri/sidecars/ingestion-sidecar/dist/
src-tauri/sidecars/ingestion-sidecar/build/
src-tauri/sidecars/ingestion-sidecar/*.spec

# Harvested corpus — bulk PDFs, never committed
corpus-harvest/
