.fastembed_cache/
src-tauri/.fastembed_cache/

# ─── Tooling / agent caches ──────────────────────────────────────────────────
.cargo/
.superpowers/
.claudeignore

# ─── Benchmark / research outputs (regenerable) ──────────────────────────────
testing results/

# ─── Environment ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Editor artefacts ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# ─── Build outputs ────────────────────────────────────────────────────────────
*.tmp
.worktrees/

# ─── Python virtualenvs ───────────────────────────────────────────────────────
.venv*/
__pycache__/
*.pyc

# ─── Build / runtime caches kept beside the repo on NTFS ─────────────────────
.cargo-ntfs/
.hf-cache/
.ort-runtime/

# ─── Database backups created by aside-then-rebuild flow ─────────────────────
