# Noviq container config — copy to deploy/docker/.env and edit, then pass with
# `--env-file`. Everything here overrides an ENV default baked into the image.

# ── Inference: VM-1 (srv1), llama.cpp serving Qwen3-8B-Q4_K_M ───────────────
# Host ROOT only — do NOT append /v1, the client adds it (services/inference/remote.rs).
#
# ⚠️ Use the PRIVATE address. Verified 2026-09-03: VM-2 reaches VM-1's PUBLIC
# <REDACTED_IP>:8080 not at all (Rapid Compute's source-IP allowlist), but the
# private path answers in 4.6 ms. Port is 8080, NOT 8000.
NOVIQ_INFER_ENGINE=remote
NOVIQ_REMOTE_URL=http://<PRIVATE_IP>:8080
NOVIQ_REMOTE_MODEL=Qwen3-8B
# llama.cpp's OpenAI-compatible server: `chat` (/v1/chat/completions).
# ⚠️ NOT `completions` — that route bypasses the chat template and Qwen3 emits
# raw <think> blocks into the answer.
NOVIQ_REMOTE_ENDPOINT=chat
# The server serves 16,384/slot (-c 32768 -np 2). We budget 8192 to stay
# comparable with production vLLM. Measured 2026-09-03 on the real corpus: the
# largest prompt reached 7,191 tokens, so 8192 is close to fully used.
NOVIQ_REMOTE_MAX_MODEL_LEN=8192
# ⚠️⚠️ A full RAG turn on the real corpus took 150 s single-user and 237 s with
# 4 in flight (measured 2026-09-03) — only 21% under this 300 s ceiling. Raise it
# before putting real load on a CPU box, or cap answer length.
NOVIQ_REMOTE_TIMEOUT_MS=300000
# ⚠️ This server DOES enforce auth (--api-key). Without it every call is a 401.
NOVIQ_REMOTE_API_KEY=noviq-9e64a5f51803275f05e2df824c431788

# ── First-boot admin (seeded once, only if no admin exists) ─────────────────
NOVIQ_ADMIN_USER=admin
NOVIQ_ADMIN_PASS=change-me-before-first-boot

# ── Retrieval pool (mirrors .env.example on the IBA VM) ─────────────────────
ECHO_VEC_K=28
ECHO_FTS_K=7
ECHO_POOL_OVERFETCH=2.0

# ── Optional: shrink the prompt for the CPU latency test ───────────────────
# ⚠️ CORRECTED 2026-09-03 by llama.cpp's own metrics: on this workload cost is
# dominated by DECODE, not prefill — 826 s generating vs 278 s prefilling (75/25).
# Prefill runs at 107 tok/s; decode at ~6-10 tok/s under 2-slot contention. So
# the effective lever is ANSWER LENGTH, not context size: capping sources helps
# far less than asking for shorter answers.
# ECHO_SOURCE_CAP=6

RUST_LOG=info
