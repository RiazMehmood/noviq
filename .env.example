# Noviq headless server (F014) — copy to .env on the server; .env is git-ignored.
# Loaded by systemd EnvironmentFile (deploy/noviq-server.service).

# Data dir owning the bundled PostgreSQL cluster + caches (on /opt, not /home).
NOVIQ_DATA_DIR=/opt/noviq/data

# Directory of the built SolidJS frontend (vite `npm run build` output).
NOVIQ_WEB_DIR=/opt/noviq/echoAI/dist

# HTTP listen address for the API + static client (front with Caddy for TLS).
NOVIQ_BIND=127.0.0.1:8080

# GPU layer offload for llama-cpp-2 (A40-12Q has 12 GB VRAM). 0 = CPU only.
NOVIQ_GPU_LAYERS=0

# Optional: secret for the future /__deploy webhook (poll-timer is primary).
# DEPLOY_SECRET=

# ── Retrieval candidate pool ────────────────────────────────────────────────
# ECHO_VEC_K : ECHO_FTS_K is the vec/keyword MIX (28:7 = 80/20), NOT a total.
# ECHO_POOL_OVERFETCH sets the DEPTH as a multiple of the live context window:
#   >= 1.0  → depth = ctx_top_k x overfetch, split by the mix above
#   unset/0 → LEGACY: the two knobs act as absolute per-arm caps (pre-2026-08-07)
# Legacy pinned the pool at 35 against a window of 36, so the merge became the
# selection and ranking/boosts/diversity had nothing to discard. See
# CHANGELOG_DEV.md 2026-08-07. Rollback = comment out ECHO_POOL_OVERFETCH + restart.
ECHO_VEC_K=28
ECHO_FTS_K=7
ECHO_POOL_OVERFETCH=2.0
